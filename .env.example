# Copy this file to .env and fill in the values.
# .env is ignored by git. Never commit it.

# --- Local blockchain (Anvil) ---
NETWORK=local
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_DATA_FILE=app/blockchain/contract_data.local.json

# Deployer key: Anvil prints 10 test accounts and their private keys when it
# starts. Paste the private key of account (0) here.
# NEVER put the key of a real wallet in this file.
DEPLOYER_PRIVATE_KEY=

# Demo users created by scripts/deploy_contract.py (min 8 characters each).
# Leave empty to be asked for them when you deploy.
ALICE_PASSPHRASE=
BOB_PASSPHRASE=
MALLORY_PASSPHRASE=
DEMO_FUND_ETH=10
